# Service-level env for `vikunja-mcp` container

# MCP metadata
MCP_SERVER_NAME=vikunja-tasks

# Runtime behavior
POLL_INTERVAL_MS=30000
TASK_CACHE_LIMIT=200
DATA_DIR=/app/data

# Optional webhook sync
PUBLIC_WEBHOOK_BASE_URL=
VIKUNJA_WEBHOOK_SECRET=

# Optional Basic Auth for outbound requests to Vikunja API
# Use ONE option below:
# 1) Full Authorization header value
VIKUNJA_BASIC_AUTH_HEADER=
# 2) Username + password to auto-generate Basic header
VIKUNJA_BASIC_AUTH_USERNAME=
VIKUNJA_BASIC_AUTH_PASSWORD=
